
{

  "hard_rules": {

    "no_direct_EXECUTABLE_assignment": true,

    "execution_is_always_derived": true,

    "only_execution_influencers_may_mutate_state": true,

    "all_other_layers_may_only_consume": true

  },

  "execution_state_model": {

    "states": [

      "DISABLED",

      "ARMED",

      "READY",

      "EXECUTABLE"

    ],

    "final_state_is_derived_only": true,

    "transitions": {

      "DISABLED": ["ARMED"],

      "ARMED": ["READY"],

      "READY": ["EXECUTABLE"],

      "EXECUTABLE": []

    }

  },

  "invariants": {

    "EXECUTABLE_is_never_stored": true,

    "registry_is_single_source_of_truth": true,

    "conflicting_sources_are_invalid": true

  }

}

