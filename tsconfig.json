
{

  "compilerOptions": {

    "target": "ES2022",

    "lib": ["ES2022"],

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "strict": false,

    "allowJs": true,

    "resolveJsonModule": true,

    "outDir": "./dist",

    "rootDir": "./",

    "baseUrl": "."

  },

  "include": [

    "./scripts",

    "./routes",

    "./db",

    "./types",

    "./server"

  ]

}

