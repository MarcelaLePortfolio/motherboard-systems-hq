
{

  "compilerOptions": {

    "target": "ES2021",

    "module": "CommonJS",

    "moduleResolution": "node",

    "strict": true,

    "noEmit": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,

    "types": ["node"],

    "lib": ["ES2021"],

    "baseUrl": "."

  },

  "include": [

    "db",

    "server",

    "routes",

    "types"

  ],

  "exclude": [

    "scripts",

    "snapshots",

    "ts-backup",

    "routes_backup",

    "**/*.mts",

    "**/*.test.ts",

    "**/*.spec.ts",

    "**/*.js"

  ]

}

