
{

  "compilerOptions": {

    "target": "ES2022",

    "lib": ["ES2022"],

    "module": "CommonJS",

    "moduleResolution": "node",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "strict": false,

    "allowJs": true,

    "resolveJsonModule": true,

    "outDir": "./dist",

    "rootDir": "./",

    "noEmitOnError": false

  },

  "include": [

    "./scripts",

    "./routes",

    "./db",

    "./server",

    "./types"

  ]

}

