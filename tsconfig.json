
{

  "compilerOptions": {

    "target": "ES2021",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "rootDir": ".",

    "outDir": "dist",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "strict": false,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,

    "types": ["node"]

  },

  "include": ["db", "server", "routes"],

  "exclude": ["scripts", "snapshots", "ts-backup", "**/*.test.ts", "**/*.spec.ts"]

}

