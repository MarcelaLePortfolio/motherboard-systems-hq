
{

  "compilerOptions": {

    "target": "ES2022",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "strict": false,

    "noImplicitAny": false

  },

  "include": ["server", "db", "routes", "scripts"],

  "exclude": ["node_modules", "dist"]

}

