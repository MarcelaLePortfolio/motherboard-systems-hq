
{

  "compilerOptions": {

    "target": "ES2022",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "strict": true,

    "skipLibCheck": true,

    "types": ["node"]

  },

  "include": [

    "server/**/*",

    "db/**/*",

    "routes/**/*",

    "src/**/*",

    "scripts/**/*"

  ],

  "exclude": [

    "scripts_backup/**",

    "scripts_backup_2/**",

    "ts-backup/**",

    "snapshots/**",

    "node_modules/**"

  ]

}

