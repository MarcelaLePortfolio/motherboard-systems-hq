
{

  "compilerOptions": {

    "target": "ES2020",

    "module": "CommonJS",

    "moduleResolution": "node",

    "rootDir": ".",

    "outDir": "dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "types": ["node"]

  },

  "include": [

    "server/**/*.ts",

    "scripts/**/*.ts",

    "routes/**/*.ts"

  ],

  "exclude": [

    "node_modules",

    "dist"

  ]

}

